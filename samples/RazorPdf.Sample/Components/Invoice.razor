@using RazorPdf.Sample.Models

<PdfDocument>
    <PdfSection>
        <PdfHeading Level="1">
            <PdfText Value="INVOICE" />
        </PdfHeading>

        <PdfParagraph>
            <PdfBold>
                <PdfText Value="@Data.Company.Name" />
            </PdfBold>
        </PdfParagraph>
        <PdfParagraph>
            <PdfItalic>
                <PdfText Value="@Data.Company.Tagline" />
            </PdfItalic>
        </PdfParagraph>

        <PdfHorizontalRule />

        <PdfHeading Level="2">
            <PdfText Value="Invoice To" />
        </PdfHeading>

        <PdfParagraph>
            <PdfBold>
                <PdfText Value="@Data.Client.Name" />
            </PdfBold>
            <PdfText Value="@($" - {Data.Client.Role}")" />
        </PdfParagraph>
        <PdfParagraph>
            <PdfText Value="@($"Phone: {Data.Client.Phone}")" />
        </PdfParagraph>
        <PdfParagraph>
            <PdfText Value="@($"Email: {Data.Client.Email}")" />
        </PdfParagraph>
        @if (!string.IsNullOrEmpty(Data.Client.Website))
        {
            <PdfParagraph>
                <PdfText Value="@($"Web: {Data.Client.Website}")" />
            </PdfParagraph>
        }

        <PdfHeading Level="2">
            <PdfText Value="Invoice Details" />
        </PdfHeading>

        <PdfParagraph>
            <PdfBold><PdfText Value="Invoice #: " /></PdfBold>
            <PdfText Value="@Data.Details.InvoiceNumber" />
        </PdfParagraph>
        <PdfParagraph>
            <PdfBold><PdfText Value="Invoice Date: " /></PdfBold>
            <PdfText Value="@Data.Details.InvoiceDate.ToString("MMMM dd, yyyy")" />
        </PdfParagraph>

        <PdfHeading Level="2">
            <PdfText Value="Items" />
        </PdfHeading>

        <PdfTable>
            <PdfTableRow IsHeader="true">
                <PdfTableCell><PdfText Value="Description" /></PdfTableCell>
                <PdfTableCell><PdfText Value="Unit Price" /></PdfTableCell>
                <PdfTableCell><PdfText Value="Qty" /></PdfTableCell>
                <PdfTableCell><PdfText Value="Total" /></PdfTableCell>
            </PdfTableRow>
            @foreach (var item in Data.Items)
            {
                <PdfTableRow>
                    <PdfTableCell>
                        <PdfBold><PdfText Value="@item.Description" /></PdfBold>
                    </PdfTableCell>
                    <PdfTableCell><PdfText Value="@($"${item.UnitPrice:N2}")" /></PdfTableCell>
                    <PdfTableCell><PdfText Value="@item.Quantity.ToString()" /></PdfTableCell>
                    <PdfTableCell><PdfText Value="@($"${item.Total:N2}")" /></PdfTableCell>
                </PdfTableRow>
            }
        </PdfTable>

        <PdfHorizontalRule />

        <PdfParagraph>
            <PdfBold><PdfText Value="@($"Subtotal: ${Data.Summary.Subtotal:N2}")" /></PdfBold>
        </PdfParagraph>
        <PdfParagraph>
            <PdfText Value="@($"Tax ({Data.Summary.TaxRate}%): ${Data.Summary.TaxAmount:N2}")" />
        </PdfParagraph>
        <PdfParagraph>
            <PdfText Value="@($"Discount ({Data.Summary.DiscountRate}%): -${Data.Summary.DiscountAmount:N2}")" />
        </PdfParagraph>

        <PdfHeading Level="2">
            <PdfText Value="@($"Grand Total: ${Data.Summary.GrandTotal:N2} USD")" />
        </PdfHeading>

        <PdfHorizontalRule />

        <PdfHeading Level="3">
            <PdfText Value="Terms &amp; Conditions" />
        </PdfHeading>
        <PdfParagraph>
            <PdfText Value="@Data.TermsAndConditions" />
        </PdfParagraph>

        <PdfParagraph>
            <PdfItalic><PdfText Value="@Data.Signature.SignatureText" /></PdfItalic>
        </PdfParagraph>
        <PdfParagraph>
            <PdfBold><PdfText Value="@Data.Signature.Name" /></PdfBold>
            <PdfText Value="@($", {Data.Signature.Title}")" />
        </PdfParagraph>

        <PdfParagraph>
            <PdfBold><PdfText Value="THANKS FOR YOUR BUSINESS" /></PdfBold>
        </PdfParagraph>
    </PdfSection>
</PdfDocument>

@code {
    [Parameter]
    public InvoiceData Data { get; set; } = new();
}
