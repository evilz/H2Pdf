@using H2Pdf.Sample.Models
@inject PdfBuildContextAccessor BuildContextAccessor

@code {
    [Parameter]
    public InvoiceData Data { get; set; } = new();

    protected override void OnInitialized()
    {
        var pdfBuilder = BuildContextAccessor.GetRequiredContext().Builder;
        var companyTitle = string.IsNullOrWhiteSpace(Data.Company.LogoText)
            ? Data.Company.Name
            : Data.Company.LogoText;

        pdfBuilder.AddSection()
            .AddHeading(companyTitle, 1)
            .AddParagraph(Data.Company.Tagline)
            .AddHeading("Invoice", 2)
            .AddParagraph($"Invoice #: {Data.Details.InvoiceNumber}")
            .AddParagraph($"Invoice Date: {Data.Details.InvoiceDate:MMMM dd, yyyy}")
            .AddParagraph($"Issue Date: {Data.Details.IssueDate:MMMM dd, yyyy}")
            .AddParagraph($"Account #: {Data.Details.AccountNumber}");

        pdfBuilder.AddHeading("Invoice To", 3)
            .AddParagraph($"{Data.Client.Name} ({Data.Client.Role})")
            .AddParagraph($"Phone: {Data.Client.Phone}")
            .AddParagraph($"Email: {Data.Client.Email}");

        if (!string.IsNullOrEmpty(Data.Client.Website))
        {
            pdfBuilder.AddParagraph($"Web: {Data.Client.Website}");
        }

        pdfBuilder.AddParagraph(Data.Client.Address);

        pdfBuilder.AddHeading("Payment Method", 3)
            .AddParagraph(Data.Payment.Method);

        if (!string.IsNullOrEmpty(Data.Payment.PayPalEmail))
        {
            pdfBuilder.AddParagraph($"PayPal: {Data.Payment.PayPalEmail}");
        }

        if (Data.Payment.AcceptedCards.Any())
        {
            pdfBuilder.AddParagraph($"Accepted: {string.Join(", ", Data.Payment.AcceptedCards)}");
        }

        pdfBuilder.AddHeading("Items", 3)
            .AddTable(table =>
            {
                table.AddHeaderRow("Description", "Unit Price", "Quantity", "Total");
                foreach (var item in Data.Items)
                {
                    table.AddRow(
                        item.Description,
                        item.UnitPrice.ToString("C"),
                        item.Quantity.ToString(),
                        item.Total.ToString("C"));
                }
            });

        pdfBuilder.AddHeading("Summary", 3)
            .AddParagraph($"Subtotal: {Data.Summary.Subtotal:C}")
            .AddParagraph($"Tax ({Data.Summary.TaxRate}%): {Data.Summary.TaxAmount:C}")
            .AddParagraph($"Discount ({Data.Summary.DiscountRate}%): -{Data.Summary.DiscountAmount:C}")
            .AddParagraph($"Grand Total: {Data.Summary.GrandTotal:C}");

        pdfBuilder.AddHeading("Terms & Conditions", 3)
            .AddParagraph(Data.TermsAndConditions);

        pdfBuilder.AddHeading("Signature", 3)
            .AddParagraph(Data.Signature.SignatureText)
            .AddParagraph($"{Data.Signature.Name} - {Data.Signature.Title}");
    }
}
