@inject PdfBuildContextAccessor BuildContextAccessor

@code {
    [Parameter]
    public string Name { get; set; } = "World";

    [Parameter]
    public string? AdditionalMessage { get; set; }

    protected override void OnInitialized()
    {
        var pdfBuilder = BuildContextAccessor.GetRequiredContext().Builder;
        pdfBuilder.AddSection()
            .AddHeading("Hello, H2Pdf!", 1)
            .AddParagraph($"Welcome {Name} to PDF generation with Razor components!")
            .AddParagraph("This content was generated from a real Razor component (.razor file) and written directly to the PDF model.");

        if (!string.IsNullOrEmpty(AdditionalMessage))
        {
            pdfBuilder.AddParagraph(paragraph =>
                paragraph.AddText(AdditionalMessage, new PdfTextStyle { Bold = true }));
        }

        pdfBuilder.AddHeading("Features Demonstrated", 2)
            .AddParagraph("• Razor syntax with parameter binding")
            .AddParagraph("• Conditional rendering with @if statements")
            .AddParagraph("• PDF document model emission")
            .AddParagraph("• Component parameters");
    }
}
